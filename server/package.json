{
  "name": "harcama-takip-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Harcama Takip backend - Express + SQLite (node:sqlite)",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^6.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "typescript": "^5.9.2"
  }
}
