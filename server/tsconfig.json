{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    /* Kaynakta ".ts" uzantisiyla import yazariz: Node bu dosyalari dogrudan
       (tip-siyirma ile) calistirabilir, tsc ise cikti uretirken uzantiyi
       ".js" olarak yeniden yazar. Boylece dev'de build beklemeden calisir. */
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    /* Node'un tip siyirma (type stripping) ozelligiyle uyumlu kalmak icin
       enum / namespace / parameter-property kullanilmaz. */
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
