# ---------------------------------------------------------------------------
# Harcama Takip - ortam degiskenleri
# Bu dosyayi ".env" olarak kopyalayin ve degerleri doldurun.
# ".env" .gitignore'dadir; gercek sirlar asla repoya girmez.
# ---------------------------------------------------------------------------

# Sunucu portu (container ICINDE dinlenen port)
PORT=4000

# Docker'da sunucunun DISARIYA actigi port. Ayni makinede 4000'i kullanan
# baska bir servis varsa burayi degistirin (or. 4001).
HOST_PORT=4000

# production | development
NODE_ENV=development

# SQLite veritabaninin tutulacagi dizin.
# Docker'da /data/db (volume), yerel gelistirmede ./data
DATA_DIR=./data

# Yuklenen ekstre/PDF dosyalarinin tutulacagi dizin
UPLOAD_DIR=./data/uploads

# Tesseract Turkce dil verisinin bulundugu dizin. Docker imajinda hazir gelir;
# yerel gelistirmede taranmis PDF okumak isterseniz tur.traineddata dosyasini
# buraya koyun (https://github.com/tesseract-ocr/tessdata).
TESSDATA_DIR=./tessdata

# Build edilmis frontend'in yolu. Yalnizca production'da kullanilir;
# gelistirmede Vite dev sunucusu devrededir.
CLIENT_DIR=../client/dist

# ---------------------------------------------------------------------------
# GUVENLIK - asagidakiler mutlaka degistirilmelidir
# ---------------------------------------------------------------------------

# JWT imzalama sirri. En az 32 karakter, rastgele olmali.
# Uretmek icin:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=degistir-bu-degeri-en-az-32-karakter-olmali
JWT_REFRESH_SECRET=degistir-bu-degeri-de-farkli-ve-en-az-32-karakter

# Token omurleri
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# Hassas alanlarin (Home Assistant erisim token'i) sifrelenmesinde kullanilan
# AES-256-GCM anahtari. 32 bayt, base64 kodlu olmali.
# DIKKAT: Bu anahtari degistirirseniz kayitli HA token'i cozulemez ve yeniden
# girilmesi gerekir.
# Uretmek icin:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=degistir-32-baytlik-base64-anahtar

# Cookie'lerin yalnizca HTTPS uzerinden gonderilmesi (production'da true olmali)
COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Zaman dilimi - planlanan odeme/fatura tarih hesaplari buna bagli
# ---------------------------------------------------------------------------
TZ=Europe/Istanbul
